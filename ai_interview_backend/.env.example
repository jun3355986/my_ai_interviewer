# =============================
# Python AI service
# =============================
# OpenCode Go chat models (do not commit a real key).
# The Python service receives this as AI_OPENAI_COMPAT_API_KEY, so it does not
# depend on Azure-specific variable names.
OPENCODE_GO_API_KEY=test-key
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1/
OPENCODE_GO_CHAT_MODEL=deepseek-v4-flash
OPENCODE_GO_FALLBACK_CHAT_MODELS=mimo-v2.5,mimo-v2.5-pro

# OpenCode Go has no embeddings endpoint. Use the Volcano Ark Agent Plan
# dedicated key here, not a normal Ark or Coding Plan key. Do not commit it.
# The /api/plan/v3 Base URL is part of the Agent Plan contract; /api/v3 can
# incur a separate charge. The API accepts dimensions=1024 for this model.
AI_EMBEDDING_API_KEY=test-key
AI_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
AI_EMBEDDING_MODEL=doubao-embedding-vision
AI_EMBEDDING_DIMENSION=1024
# Existing vectors generated by another model must not share this collection.
AI_INTERVIEW_VECTOR_COLLECTION=interview_questions_doubao_embedding_vision_251215_1024_v1

# Local observability writes trace, token and latency aggregates to PostgreSQL.
# Keep raw prompt/response storage disabled unless an authorized debugging case
# requires it.
AI_OBSERVABILITY_ENABLED=true
AI_OBSERVABILITY_DB_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_interviewer
AI_OBSERVABILITY_STORE_RAW_PAYLOAD=false

# =============================
# Java services
# =============================
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing-must-be-at-least-32-characters
ADMIN_JWT_SECRET=your-admin-256-bit-secret-key-for-jwt-signing-change-me
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-XX:InitialRAMPercentage=25 -XX:MaxRAMPercentage=75

# =============================
# MinIO
# =============================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=ai-interviewer

# Optional: notification service (profile=notification)
ROCKETMQ_NAMESRV_ADDR=localhost:9876

# Frontend web build arg (for flutter --dart-define=GATEWAY_BASE_URL)
# 容器内默认推荐 "/"，由 nginx 反代到 gateway。
# 也可改为完整地址，例如 https://api.example.com
FRONTEND_GATEWAY_BASE_URL=/

# Admin React web build arg.
# 容器内默认推荐 "/admin"，由 admin-web Nginx 反代到 gateway。
ADMIN_WEB_API_BASE=/admin
