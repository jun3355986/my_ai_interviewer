# =============================
# Python AI service
# =============================
# 建议替换为真实 Key。若保留 test-key，服务会在启动或调用阶段报错。
# 本机可从 /Users/junjielong/myai/My_AI_KEY.md 读取 Azure key/模型信息。
AZURE_OPENAI_API_KEY=test-key
AZURE_OPENAI_ENDPOINT=https://liuwe-m7o7yvmk-eastus2.services.ai.azure.com/openai/v1/
AZURE_OPENAI_CHAT_MODEL=grok-4-20-reasoning
AZURE_OPENAI_BACKUP_CHAT_MODEL=gpt-5.4
AZURE_OPENAI_EMBEDDING_MODEL=embed-v-4-0
AZURE_OPENAI_EMBEDDING_DIMENSION=1024

# =============================
# Java services
# =============================
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing-must-be-at-least-32-characters
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-XX:InitialRAMPercentage=25 -XX:MaxRAMPercentage=75

# =============================
# MinIO
# =============================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=ai-interviewer

# Optional: notification service (profile=notification)
ROCKETMQ_NAMESRV_ADDR=localhost:9876

# Frontend web build arg (for flutter --dart-define=GATEWAY_BASE_URL)
# 容器内默认推荐 "/"，由 nginx 反代到 gateway。
# 也可改为完整地址，例如 https://api.example.com
FRONTEND_GATEWAY_BASE_URL=/
