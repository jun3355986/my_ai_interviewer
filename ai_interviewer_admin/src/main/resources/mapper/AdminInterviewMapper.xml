<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiinterviewer.admin.interview.mapper.AdminInterviewMapper">

    <resultMap id="AdminInterviewListItemMap" type="com.aiinterviewer.admin.interview.AdminInterviewService$AdminInterviewListItem">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="jobId" column="job_id"/>
        <result property="jobTitle" column="job_title"/>
        <result property="candidateName" column="candidate_name"/>
        <result property="stage" column="stage"/>
        <result property="status" column="status"/>
        <result property="startedAt" column="started_at"/>
        <result property="finishedAt" column="finished_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="AdminInterviewDetailMap" type="com.aiinterviewer.admin.interview.AdminInterviewService$AdminInterviewDetail">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="resumeId" column="resume_id"/>
        <result property="jobId" column="job_id"/>
        <result property="jobTitle" column="job_title"/>
        <result property="candidateName" column="candidate_name"/>
        <result property="stage" column="stage"/>
        <result property="status" column="status"/>
        <result property="resumeContent" column="resume_content"/>
        <result property="jobRequirements" column="job_requirements"/>
        <result property="projectQuestionsCount" column="project_questions_count"/>
        <result property="targetProjectQuestions" column="target_project_questions"/>
        <result property="projectQuestionsPoolJson" column="project_questions_pool_json"/>
        <result property="technicalQuestionsPoolJson" column="technical_questions_pool_json"/>
        <result property="currentFollowupCount" column="current_followup_count"/>
        <result property="pythonSessionId" column="python_session_id"/>
        <result property="startedAt" column="started_at"/>
        <result property="finishedAt" column="finished_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="AdminInterviewMessageItemMap" type="com.aiinterviewer.admin.interview.AdminInterviewService$AdminInterviewMessageItem">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="stage" column="stage"/>
        <result property="sequence" column="sequence"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <resultMap id="AdminScoreRecordItemMap" type="com.aiinterviewer.admin.interview.AdminInterviewService$AdminScoreRecordItem">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="questionIndex" column="question_index"/>
        <result property="questionType" column="question_type"/>
        <result property="question" column="question"/>
        <result property="answer" column="answer"/>
        <result property="score" column="score"/>
        <result property="feedback" column="feedback"/>
        <result property="followup" column="is_followup"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <resultMap id="AdminEvaluationSummaryMap" type="com.aiinterviewer.admin.interview.AdminInterviewService$AdminEvaluationSummary">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="overallScore" column="overall_score"/>
        <result property="technicalScore" column="technical_score"/>
        <result property="communicationScore" column="communication_score"/>
        <result property="logicScore" column="logic_score"/>
        <result property="experienceScore" column="experience_score"/>
        <result property="summary" column="summary"/>
        <result property="strengths" column="strengths"/>
        <result property="weaknesses" column="weaknesses"/>
        <result property="recommendation" column="recommendation"/>
        <result property="detailedFeedback" column="detailed_feedback"/>
        <result property="totalQuestions" column="total_questions"/>
        <result property="answeredQuestions" column="answered_questions"/>
        <result property="averageScore" column="average_score"/>
        <result property="durationMinutes" column="duration_minutes"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="DiagnosisSessionSnapshotMap" type="com.aiinterviewer.admin.interview.AdminInterviewService$DiagnosisSessionSnapshot">
        <id property="id" column="id"/>
        <result property="stage" column="stage"/>
        <result property="status" column="status"/>
        <result property="technicalQuestionsPoolJson" column="technical_questions_pool_json"/>
        <result property="startedAt" column="started_at"/>
        <result property="finishedAt" column="finished_at"/>
        <result property="scoreRecordCount" column="score_record_count"/>
        <result property="nullScoreCount" column="null_score_count"/>
        <result property="technicalScoreRecordCount" column="technical_score_record_count"/>
    </resultMap>

    <sql id="InterviewFilter">
        FROM t_interview_session s
        LEFT JOIN t_user u ON u.id = s.user_id
        LEFT JOIN t_job j ON j.id = s.job_id
        WHERE 1 = 1
        <if test="query.userId != null">
            AND s.user_id = #{query.userId}
        </if>
        <if test="query.jobId != null">
            AND s.job_id = #{query.jobId}
        </if>
        <if test="query.stage != null">
            AND LOWER(s.stage) = #{query.stage}
        </if>
        <if test="query.status != null">
            AND s.status = #{query.status}
        </if>
        <if test="query.startedFrom != null">
            AND s.started_at &gt;= #{query.startedFrom}
        </if>
        <if test="query.startedTo != null">
            AND s.started_at &lt;= #{query.startedTo}
        </if>
    </sql>

    <select id="countInterviews" resultType="long">
        SELECT COUNT(*)
        <include refid="InterviewFilter"/>
    </select>

    <select id="selectInterviews" resultMap="AdminInterviewListItemMap">
        SELECT s.id, s.user_id, u.username, s.job_id, j.title AS job_title,
               s.candidate_name, s.stage, s.status, s.started_at, s.finished_at,
               s.created_at, s.updated_at
        <include refid="InterviewFilter"/>
        ORDER BY s.started_at DESC NULLS LAST, s.created_at DESC, s.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectInterviewDetail" resultMap="AdminInterviewDetailMap">
        SELECT s.id, s.user_id, u.username, s.resume_id, s.job_id, j.title AS job_title,
               s.candidate_name, s.stage, s.status, s.resume_content, s.job_requirements,
               s.project_questions_count, s.target_project_questions,
               COALESCE(s.project_questions_pool, '[]'::jsonb)::text AS project_questions_pool_json,
               COALESCE(s.technical_questions_pool, '[]'::jsonb)::text AS technical_questions_pool_json,
               s.current_followup_count, s.python_session_id, s.started_at, s.finished_at,
               s.created_at, s.updated_at
        FROM t_interview_session s
        LEFT JOIN t_user u ON u.id = s.user_id
        LEFT JOIN t_job j ON j.id = s.job_id
        WHERE s.id = #{sessionId}
    </select>

    <select id="selectMessages" resultMap="AdminInterviewMessageItemMap">
        SELECT id, session_id, role, content, stage, sequence, created_at
        FROM t_interview_message
        WHERE session_id = #{sessionId}
        ORDER BY sequence ASC, id ASC
    </select>

    <select id="selectScoreRecords" resultMap="AdminScoreRecordItemMap">
        SELECT id, session_id, question_index, question_type, question, answer, score,
               feedback, is_followup, created_at
        FROM t_score_record
        WHERE session_id = #{sessionId}
        ORDER BY question_index ASC, id ASC
    </select>

    <select id="selectEvaluationSummary" resultMap="AdminEvaluationSummaryMap">
        SELECT id, session_id, overall_score, technical_score, communication_score,
               logic_score, experience_score, summary, strengths, weaknesses, recommendation,
               detailed_feedback::text AS detailed_feedback, total_questions, answered_questions,
               average_score, duration_minutes, created_at, updated_at
        FROM t_evaluation
        WHERE session_id = #{sessionId}
    </select>

    <select id="selectDiagnosisSnapshot" resultMap="DiagnosisSessionSnapshotMap">
        SELECT s.id, s.stage, s.status,
               s.technical_questions_pool::text AS technical_questions_pool_json,
               s.started_at, s.finished_at,
               COUNT(sr.id) AS score_record_count,
               COUNT(sr.id) FILTER (WHERE sr.score IS NULL) AS null_score_count,
               COUNT(sr.id) FILTER (WHERE LOWER(sr.question_type) = 'technical') AS technical_score_record_count
        FROM t_interview_session s
        LEFT JOIN t_score_record sr ON sr.session_id = s.id
        WHERE s.id = #{sessionId}
        GROUP BY s.id, s.stage, s.status, s.technical_questions_pool, s.started_at, s.finished_at
    </select>

    <select id="selectSessionStatus" resultType="int">
        SELECT status
        FROM t_interview_session
        WHERE id = #{sessionId}
    </select>

    <update id="cancelSession">
        UPDATE t_interview_session
        SET status = 3,
            finished_at = COALESCE(finished_at, CURRENT_TIMESTAMP),
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{sessionId}
          AND status = 1
    </update>
</mapper>
