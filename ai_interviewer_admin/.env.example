# Admin service Docker Compose defaults
SERVER_PORT=9010

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_interviewer
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Nacos
NACOS_SERVER_ADDR=nacos:8848
NACOS_ENABLED=true

# JWT
# Replace this in any shared or production-like environment.
ADMIN_JWT_SECRET=ai-interviewer-admin-local-secret-change-me-please
ADMIN_JWT_ACCESS_TOKEN_EXPIRATION=7200000

# Python AI integration
PYTHON_AI_QUESTION_BANK_SYNC_URL=http://python-ai:8000/admin/question-bank/sync
