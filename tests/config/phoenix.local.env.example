# Local-only Phoenix tracing for the Agent evaluation lab.
# Copy this file to tests/config/phoenix.local.env before running experiments.
# Never place a cloud API key, real candidate PII, or production endpoint here.

# Phoenix is served locally by tests/scripts/start-phoenix-local.sh.
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
PHOENIX_PROJECT_NAME=ai-interviewer-agent-eval
PHOENIX_TELEMETRY_ENABLED=false
PHOENIX_AGENTS_DISABLE_WEB_ACCESS=true
PHOENIX_AGENTS_DISABLE_BASH=true
PHOENIX_ALLOWED_PROVIDERS=NONE

# Keep the existing LangSmith path disabled during the first Phoenix experiment
# so one LLM invocation is not accidentally exported to two tracing backends.
LANGSMITH_TRACING=false
LANGSMITH_EVALUATION_SYNC=false

# Preserve the project's redacted-by-default local recorder behavior.
MANUAL_FLOW_RECORDER_ENABLED=false
MANUAL_FLOW_RECORDER_CAPTURE_RAW_PAYLOADS=false
